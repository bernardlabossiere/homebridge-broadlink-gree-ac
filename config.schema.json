{
  "pluginAlias": "BroadlinkGreeAC",
  "pluginType": "platform",
  "singular": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Broadlink GREE AC",
        "required": true
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "type": "string",
              "required": true
            },
            "host": {
              "title": "Broadlink RM4 IP Address",
              "type": "string",
              "required": true
            },
            "mac": {
              "title": "MAC Address (optional)",
              "type": "string",
              "description": "Leave empty \u2014 auto-discovered from IP. Format: aabbccddeeff"
            },
            "irCodesFile": {
              "title": "SmartIR JSON File Path (optional)",
              "type": "string",
              "description": "Leave empty to use bundled GREE 1180.json. Custom path e.g. /homebridge/mymodel.json"
            },
            "minTemperature": {
              "title": "Min Temperature (\u00b0C)",
              "type": "number",
              "default": 8
            },
            "maxTemperature": {
              "title": "Max Temperature (\u00b0C)",
              "type": "number",
              "default": 30
            },
            "antiFrostSwitch": {
              "title": "Enable Anti-Frost Switch",
              "type": "boolean",
              "default": true
            },
            "antiFrostTemperature": {
              "title": "Anti-Frost Temperature (\u00b0C)",
              "type": "number",
              "default": 8
            },
            "antiFrostNameSuffix": {
              "title": "Anti-Frost Switch Name Suffix",
              "type": "string",
              "default": "anti-frost"
            }
          }
        }
      }
    }
  }
}
